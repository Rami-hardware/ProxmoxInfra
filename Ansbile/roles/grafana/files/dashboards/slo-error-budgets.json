  {
   "id": 4,
   "type": "timeseries",
   "title": "Availability 1h vs SLO",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 9,
    "w": 12,
    "x": 0,
    "y": 6
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "fillOpacity": 10,
      "lineWidth": 2
     },
     "min": 0.98,
     "thresholds": {
      "mode": "absolute",
      "steps": []
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "targets": [
    {
     "expr": "slo:availability:1h",
     "legendFormat": "{{scope}} (1h)",
     "refId": 1
    },
    {
     "expr": "vector(0.995)",
     "legendFormat": "SLO 99.5%",
     "refId": 2
    },
    {
     "expr": "vector(0.999)",
     "legendFormat": "SLO 99.9%",
     "refId": 3
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Burn rate 1h (1.0 = sustainable pace)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 9,
    "w": 12,
    "x": 12,
    "y": 6
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "fillOpacity": 10,
      "lineWidth": 2
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 14.4
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "targets": [
    {
     "expr": "(1 - slo:availability:1h{scope=\"local\"}) / 0.005",
     "legendFormat": "burn local",
     "refId": 1
    },
    {
     "expr": "(1 - slo:availability:1h{scope=\"public\"}) / 0.005",
     "legendFormat": "burn public",
     "refId": 2
    },
    {
     "expr": "(1 - slo:availability:1h{scope=\"dns\"}) / 0.001",
     "legendFormat": "burn dns",
     "refId": 3
    }
   ]
  },
  {
