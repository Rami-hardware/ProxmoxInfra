{
 "uid": "homelab-slo",
 "title": "SLOs & Error Budgets",
 "tags": [
  "slo",
  "homelab"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "30s",
 "time": {
  "from": "now-3d",
  "to": "now"
 },
 "templating": {
  "list": []
 },
 "annotations": {
  "list": []
 },
 "panels": [
  {
   "id": 1,
   "type": "gauge",
   "title": "Error budget remaining \u2014 LOCAL (99.5%)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 6,
    "w": 8,
    "x": 0,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": -1,
     "max": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 0
       },
       {
        "color": "yellow",
        "value": 0.25
       },
       {
        "color": "green",
        "value": 0.5
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "showThresholdLabels": false,
    "showThresholdMarkers": true
   },
   "targets": [
    {
     "expr": "slo:error_budget_remaining{scope=\"local\"}",
     "legendFormat": "{{scope}}",
     "refId": "A"
    }
   ]
  },
