    {
      "type": "timeseries",
      "title": "Requests per second by site",
      "description": "Every request handled by ingress-nginx (LAN and tunnel).",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (host) (rate(nginx_ingress_controller_requests[$__rate_interval]))",
          "legendFormat": "{{host}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 16,
