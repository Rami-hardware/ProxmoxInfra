              },
              {
                "color": "orange",
                "value": 50
              },
              {
                "color": "red",
                "value": 200
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "id": 16,
      "gridPos": {
        "x": 8,
        "y": 26,
        "w": 4,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "timeseries",
      "title": "CoreDNS (cluster DNS)",
      "description": "Since Istio ambient, ztunnel answers in-cluster names itself; what reaches CoreDNS is mostly external names.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(coredns_dns_requests_total[$__rate_interval]))",
          "legendFormat": "queries",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum(rate(coredns_cache_misses_total[$__rate_interval]))",
          "legendFormat": "sent upstream (cache misses)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
