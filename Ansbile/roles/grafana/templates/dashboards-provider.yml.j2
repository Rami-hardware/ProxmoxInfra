apiVersion: 1

providers:
  - name: default
    orgId: 1
    folder: Homelab
    type: file
    disableDeletion: false
    allowUiUpdates: true
    options:
      # NOTE: must NOT point at the provisioning folder itself (/etc/grafana/
      # provisioning/...) — grafana's file reader silently skips its own
      # provisioning tree. The same files are visible via the data PVC path.
      path: /opt/docker/grafana/provisioning/dashboards
