# Scraparr configuration
# Generated by Ansible

server:
  host: "0.0.0.0"
  port: {{ scraparr_port }}

{% if (sonarr_api_key | default('')) | length > 0 %}
sonarr:
  url: "{{ scraparr_sonarr.url }}"
  api_key: "{{ sonarr_api_key }}"
  api_version: "v3"
{% endif %}

{% if (bazarr_api_key | default('')) | length > 0 %}
bazarr:
  url: "{{ scraparr_bazarr.url }}"
  api_key: "{{ bazarr_api_key }}"
  api_version: "v3"
{% endif %}

{% if (prowlarr_api_key | default('')) | length > 0 %}
prowlarr:
  url: "{{ scraparr_prowlarr.url }}"
  api_key: "{{ prowlarr_api_key }}"
  api_version: "v1"
{% endif %}

{% if (radarr_api_key | default('')) | length > 0 %}
radarr:
  url: "{{ scraparr_radarr.url }}"
  api_key: "{{ radarr_api_key }}"
  api_version: "v3"
{% endif %}

{% if (seerr_api_key | default('')) | length > 0 %}
# "overseerr" is scraparr's own schema key, not our service name — scraparr has
# no "seerr" key, so this must stay as-is even though the app is now Seerr.
overseerr:
  url: "{{ scraparr_seerr.url }}"
  api_key: "{{ seerr_api_key }}"
  api_version: "v1"
{% endif %}
