groups:
  - name: node.rules
    interval: 1m
    rules:
      # Load average: use 15-min average so short CI bursts (< 10 min) never fire
      - alert: HighLoadAverage
        expr: node_load15 > {{ prometheus_alert_load_threshold }}
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "High load average on {{ "{{" }} $labels.instance {{ "}}" }}"
          description: >-
            15-min load avg is {{ "{{" }} $value | printf "%.2f" {{ "}}" }}
            (threshold: {{ prometheus_alert_load_threshold }})

      - alert: HighMemoryUsage
        expr: >
          (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100
          > {{ prometheus_alert_memory_threshold }}
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "High memory usage on {{ "{{" }} $labels.instance {{ "}}" }}"
          description: >-
            Memory used: {{ "{{" }} $value | printf "%.1f" {{ "}}" }}%
            (threshold: {{ prometheus_alert_memory_threshold }}%)

      - alert: HighDiskUsage
        expr: >
          (1 - node_filesystem_avail_bytes{fstype!~"tmpfs|overlay|squashfs"}
             / node_filesystem_size_bytes{fstype!~"tmpfs|overlay|squashfs"}) * 100
          > {{ prometheus_alert_disk_threshold }}
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "High disk usage on {{ "{{" }} $labels.instance {{ "}}" }} ({{ "{{" }} $labels.mountpoint {{ "}}" }})"
          description: >-
            Disk used: {{ "{{" }} $value | printf "%.1f" {{ "}}" }}%
            (threshold: {{ prometheus_alert_disk_threshold }}%)

      - alert: NodeDown
        expr: up{job="nodes"} == 0
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "Node {{ "{{" }} $labels.instance {{ "}}" }} is unreachable"
          description: "Prometheus cannot scrape node-exporter on {{ "{{" }} $labels.instance {{ "}}" }}"
