---
# ── Secrets (sensitive values mounted as files via _FILE env vars) ────────────
apiVersion: v1
kind: Secret
metadata:
  name: authelia-secrets
  namespace: network
type: Opaque
stringData:
  jwt_secret: "{{ authelia_jwt_secret }}"
  session_secret: "{{ authelia_session_secret }}"
  encryption_key: "{{ authelia_encryption_key }}"
---
# ── Config (configuration.yml + users_database.yml) ──────────────────────────
apiVersion: v1
kind: ConfigMap
metadata:
  name: authelia-config
  namespace: network
data:
  configuration.yml: |
{{ lookup('template', 'configuration.yml.j2') | indent(4, first=true) }}
  users_database.yml: |
{{ lookup('template', 'users_database.yml.j2') | indent(4, first=true) }}
---
apiVersion: v1
kind: PersistentVolume
metadata:
  name: authelia-data-pv
spec:
  capacity:
    storage: 1Gi
  accessModes:
    - ReadWriteOnce
  persistentVolumeReclaimPolicy: Retain
  storageClassName: ""
  hostPath:
    path: /opt/authelia/data
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: authelia-data-pvc
  namespace: network
spec:
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: 1Gi
  volumeName: authelia-data-pv
  storageClassName: ""
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: authelia
  namespace: network
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: authelia
  template:
    metadata:
      labels:
        app: authelia
    spec:
      enableServiceLinks: false
      nodeSelector:
        kubernetes.io/hostname: security-server
      containers:
        - name: authelia
          image: authelia/authelia:latest
          ports:
            - containerPort: 9091
          env:
            - name: AUTHELIA_IDENTITY_VALIDATION_RESET_PASSWORD_JWT_SECRET_FILE
              value: /secrets/jwt_secret
            - name: AUTHELIA_SESSION_SECRET_FILE
              value: /secrets/session_secret
            - name: AUTHELIA_STORAGE_ENCRYPTION_KEY_FILE
              value: /secrets/encryption_key
          volumeMounts:
            - name: config
              mountPath: /config
            - name: secrets
              mountPath: /secrets
              readOnly: true
            - name: data
              mountPath: /data
          resources:
            requests:
              memory: "128Mi"
              cpu: "100m"
            limits:
              memory: "512Mi"
              cpu: "500m"
      volumes:
        - name: config
          configMap:
            name: authelia-config
        - name: secrets
          secret:
            secretName: authelia-secrets
        - name: data
          persistentVolumeClaim:
            claimName: authelia-data-pvc
---
apiVersion: v1
kind: Service
metadata:
  name: authelia
  namespace: network
spec:
  selector:
    app: authelia
  ports:
    - port: 9091
      targetPort: 9091
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: authelia-local
  namespace: network
spec:
  ingressClassName: nginx
  tls:
    - hosts:
        - auth.homelab.lan
      secretName: local-tls
  rules:
    - host: auth.homelab.lan
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: authelia
                port:
                  number: 9091
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: authelia-public
  namespace: network
spec:
  ingressClassName: nginx
  tls:
    - hosts:
        - auth.darkestserver.com
      secretName: cloudflare-origin-tls
  rules:
    - host: auth.darkestserver.com
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: authelia
                port:
                  number: 9091
