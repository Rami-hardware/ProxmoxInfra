server:
  host: 0.0.0.0
  port: 9091
  tls:
    key: /certs/authelia.key
    cert: /certs/authelia.crt

log:
  level: info

authentication_backend:
  file:
    path: /config/users_database.yml

access_control:
  default_policy: two_factor
  rules: []

session:
  name: authelia_session
  secret: your_super_secret_session_key_here
  expiration: 3600
  inactivity: 300
  domain: example.com  # must be your actual domain
  # remove session.cookies section; no longer valid

storage:
  local:
    path: /config/db.sqlite3
  encryption_key: your_long_random_encryption_key_here

notifier:
  filesystem:
    filename: /config/notification.txt

identity_validation:
  reset_password:
    disable: true
