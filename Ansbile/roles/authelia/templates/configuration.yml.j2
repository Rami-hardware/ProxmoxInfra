server:
  address: tcp://0.0.0.0:9091

session:
  cookies:
    - domain: homelab.lan
      authelia_url: https://auth.homelab.lan
      expiration: 3600
      inactivity: 300
    - domain: darkestserver.com
      authelia_url: https://auth.darkestserver.com
      expiration: 3600
      inactivity: 300

authentication_backend:
  file:
    path: /config/users_database.yml

access_control:
  default_policy: deny
  rules:
    - domain:
        - auth.homelab.lan
        - auth.darkestserver.com
      policy: bypass
    - domain: "*.homelab.lan"
      policy: one_factor
    - domain: "*.darkestserver.com"
      policy: two_factor

storage:
  local:
    path: /data/db.sqlite3

notifier:
  filesystem:
    filename: /data/notification.txt
