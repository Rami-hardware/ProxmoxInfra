server:
  host: 0.0.0.0
  port: 9091
  tls:
    key: /certs/authelia.key
    certificate: /certs/authelia.crt

session:
  name: authelia_session
  secret: "supersecret_session_key_here"
  expiration: 3600
  inactivity: 300
  # Remove 'domain'; use 'domains' instead if needed
  domains: ["respawnxd.co"]

authentication_backend:
  file:
    path: /config/users_database.yml

access_control:
  default_policy: two_factor
  rules: []

storage:
  local:
    path: /config/db.sqlite3
  encryption_key: "supersecret_encryption_key_here"

notifier:
  filesystem:
    filename: /config/notification.txt

identity_validation:
  reset_password:
    jwt_secret: "supersecret_jwt_key_here"
