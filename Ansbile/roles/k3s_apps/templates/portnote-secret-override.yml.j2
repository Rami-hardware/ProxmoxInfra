---
apiVersion: v1
kind: Secret
metadata:
  name: portnote-secret
  namespace: network
type: Opaque
stringData:
  JWT_SECRET: "{{ lookup('env', 'PORTNOTE_JWT_SECRET') | default('change-me-jwt-secret', true) }}"
  USER_SECRET: "{{ lookup('env', 'PORTNOTE_USER_SECRET') | default('change-me-user-secret', true) }}"
  LOGIN_USERNAME: admin
  LOGIN_PASSWORD: "{{ lookup('env', 'PORTNOTE_LOGIN_PASSWORD') | default('change-me-admin-password', true) }}"
