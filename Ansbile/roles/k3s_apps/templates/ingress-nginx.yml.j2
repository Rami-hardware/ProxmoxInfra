---
# ──────────────────────────────────────────────────────────────────────────────
# ingress-nginx controller
# ──────────────────────────────────────────────────────────────────────────────
apiVersion: v1
kind: Namespace
metadata:
  name: ingress-nginx
  labels:
    app.kubernetes.io/name: ingress-nginx
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: ingress-nginx
  namespace: ingress-nginx
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: ingress-nginx-controller
  namespace: ingress-nginx
data:
  # Snippet annotations are required for per-service caching rules below.
  # Safe in this homelab because all Ingress objects are managed via Ansible —
  # no untrusted users can create Ingress resources. Do NOT enable in multi-tenant clusters.
  allow-snippet-annotations: "true"
  annotations-risk-level: "Critical"
  use-forwarded-headers: "true"
  compute-full-forwarded-for: "true"

  # ── Compression — shrinks HTML/JS/CSS/JSON payloads for web UIs ───────────
  use-gzip: "true"
  gzip-level: "5"
  gzip-types: "application/javascript application/json application/rss+xml application/vnd.ms-fontobject application/x-javascript application/xhtml+xml application/xml font/opentype image/svg+xml image/x-icon text/css text/javascript text/plain text/xml"

  # ── Upstream keepalive — reuse backend connections ────────────────────────
  upstream-keepalive-connections: "50"
  upstream-keepalive-time: "1h"
  upstream-keepalive-requests: "10000"

  # ── Streaming / buffering ─────────────────────────────────────────────────
  proxy-buffering: "off"
  proxy-request-buffering: "off"
  proxy-buffer-size: "50k"

  # 0 = unlimited — required for large file uploads/transcodes
  proxy-body-size: "0"

  # ── Client keepalive ──────────────────────────────────────────────────────
  keep-alive: "75"
  keep-alive-requests: "10000"

  # ── Upstream timeouts for long-running streams (1 hour) ───────────────────
  proxy-read-timeout: "3600"
  proxy-send-timeout: "3600"
  proxy-connect-timeout: "10"

  # ── Worker tuning ─────────────────────────────────────────────────────────
  worker-processes: "auto"
  worker-connections: "8192"
  max-worker-connections: "16384"

  # ── SSL — session reuse avoids TLS handshake overhead ────────────────────
  ssl-session-cache: "shared:SSL:50m"
  ssl-session-timeout: "10m"
  ssl-protocols: "TLSv1.2 TLSv1.3"
  ssl-ciphers: "ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305"

  # ── HTTP/2 + low-latency TCP ──────────────────────────────────────────────
  use-http2: "true"
  tcp-nodelay: "on"

  # ── Cloudflare real client IP ─────────────────────────────────────────────
  # Without this, all public requests show Cloudflare's IP — breaks logs,
  # rate limiting, auth, CrowdSec. List of CF IPv4 ranges (refresh from
  # https://www.cloudflare.com/ips-v4 periodically).
  enable-real-ip: "true"
  forwarded-for-header: "CF-Connecting-IP"
  proxy-real-ip-cidr: "173.245.48.0/20,103.21.244.0/22,103.22.200.0/22,103.31.4.0/22,141.101.64.0/18,108.162.192.0/18,190.93.240.0/20,188.114.96.0/20,197.234.240.0/22,198.41.128.0/17,162.158.0.0/15,104.16.0.0/13,104.24.0.0/14,172.64.0.0/13,131.0.72.0/22"

  # ── HSTS — force HTTPS for public services ────────────────────────────────
  hsts: "true"
  hsts-max-age: "31536000"
  hsts-include-subdomains: "false"

  http-snippet: |
    proxy_cache_path /tmp/nginx-cache levels=1:2 keys_zone=ingress_cache:10m max_size=5g inactive=7d use_temp_path=off;
---
# ── RBAC ──────────────────────────────────────────────────────────────────────
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: ingress-nginx
rules:
  - apiGroups: [""]
    resources: [configmaps, endpoints, nodes, pods, secrets, namespaces, services]
    verbs: [get, list, watch]
  - apiGroups: [""]
    resources: [events]
    verbs: [create, patch]
  - apiGroups: ["networking.k8s.io"]
    resources: [ingresses, ingressclasses]
    verbs: [get, list, watch]
  - apiGroups: ["networking.k8s.io"]
    resources: [ingresses/status]
    verbs: [update]
  - apiGroups: ["coordination.k8s.io"]
    resources: [leases]
    verbs: [list, watch]
  - apiGroups: ["discovery.k8s.io"]
    resources: [endpointslices]
    verbs: [get, list, watch]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: ingress-nginx
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: ingress-nginx
subjects:
  - kind: ServiceAccount
    name: ingress-nginx
    namespace: ingress-nginx
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: ingress-nginx
  namespace: ingress-nginx
rules:
  - apiGroups: [""]
    resources: [namespaces, configmaps, pods, secrets, endpoints, services]
    verbs: [get, list, watch]
  - apiGroups: [""]
    resources: [events]
    verbs: [create, patch]
  - apiGroups: ["networking.k8s.io"]
    resources: [ingresses, ingressclasses]
    verbs: [get, list, watch]
  - apiGroups: ["networking.k8s.io"]
    resources: [ingresses/status]
    verbs: [update]
  - apiGroups: ["coordination.k8s.io"]
    resources: [leases]
    verbs: [get, list, watch, create, update, patch]
  - apiGroups: ["discovery.k8s.io"]
    resources: [endpointslices]
    verbs: [get, list, watch]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: ingress-nginx
  namespace: ingress-nginx
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: ingress-nginx
subjects:
  - kind: ServiceAccount
    name: ingress-nginx
    namespace: ingress-nginx
---
# ── Controller Deployment ─────────────────────────────────────────────────────
apiVersion: apps/v1
kind: Deployment
metadata:
  name: ingress-nginx-controller
  namespace: ingress-nginx
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: ingress-nginx
      app.kubernetes.io/component: controller
  template:
    metadata:
      labels:
        app.kubernetes.io/name: ingress-nginx
        app.kubernetes.io/component: controller
    spec:
      serviceAccountName: ingress-nginx
      terminationGracePeriodSeconds: 30
      # Single replica → must NOT be evicted under memory pressure.
      # system-cluster-critical = won't be preempted by user workloads.
      priorityClassName: system-cluster-critical
      nodeSelector:
        kubernetes.io/hostname: {{ ingress_nginx_node | default('git-k3s-server') }}
      securityContext:
        runAsNonRoot: true
        runAsUser: 101
        runAsGroup: 82
      containers:
        - name: controller
          image: registry.k8s.io/ingress-nginx/controller:v1.12.1
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: false
            capabilities:
              drop: ["ALL"]
              add: ["NET_BIND_SERVICE"]
            seccompProfile:
              type: RuntimeDefault
          args:
            - /nginx-ingress-controller
            - --configmap=$(POD_NAMESPACE)/ingress-nginx-controller
            - --ingress-class=nginx
            - --watch-ingress-without-class=false
            - --enable-annotation-validation=true
            - --enable-metrics=true
            - --metrics-per-host=false
          env:
            - name: POD_NAME
              valueFrom:
                fieldRef:
                  fieldPath: metadata.name
            - name: POD_NAMESPACE
              valueFrom:
                fieldRef:
                  fieldPath: metadata.namespace
            - name: LD_PRELOAD
              value: /usr/local/lib/libmimalloc.so
          ports:
            - name: http
              containerPort: 80
            - name: https
              containerPort: 443
            - name: metrics
              containerPort: 10254
              hostPort: 10254
          # Liveness loose (5 failures = 50s) so transient load doesn't restart.
          # Readiness tight (2 failures = 10s) so traffic re-routes fast on issue.
          livenessProbe:
            httpGet:
              path: /healthz
              port: 10254
            initialDelaySeconds: 10
            periodSeconds: 10
            failureThreshold: 5
          readinessProbe:
            httpGet:
              path: /healthz
              port: 10254
            initialDelaySeconds: 5
            periodSeconds: 5
            failureThreshold: 2
          resources:
            requests:
              cpu: "200m"
              memory: "256Mi"
            limits:
              cpu: "2000m"
              memory: "1Gi"
---
# ── LoadBalancer Service ──────────────────────────────────────────────────────
# externalIPs ensures kube-proxy routes git-k3s-server:80/443 → ingress pods
# without needing MetalLB or klipper-lb (both disabled in this cluster).
apiVersion: v1
kind: Service
metadata:
  name: ingress-nginx-controller
  namespace: ingress-nginx
spec:
  type: LoadBalancer
  externalIPs:
    - {{ hostvars['gateway-server']['ansible_host'] }}
{% if (ingress_nginx_node | default('git-k3s-server')) != 'gateway-server' %}
    - {{ hostvars[ingress_nginx_node | default('git-k3s-server')]['ansible_host'] }}
{% endif %}
  selector:
    app.kubernetes.io/name: ingress-nginx
    app.kubernetes.io/component: controller
  ports:
    - name: http
      port: 80
      targetPort: http
      protocol: TCP
    - name: https
      port: 443
      targetPort: https
      protocol: TCP
---
# ── IngressClass ──────────────────────────────────────────────────────────────
apiVersion: networking.k8s.io/v1
kind: IngressClass
metadata:
  name: nginx
spec:
  controller: k8s.io/ingress-nginx
