---
controller:
  # One replica per node in k3s_apps_ingress_nodes. With hostNetwork each pod
  # owns 80/443 on its node, and externalTrafficPolicy: Local makes MetalLB
  # announce the LoadBalancer IP only from a node with a Ready pod, so if one
  # node goes down the IP moves to the other.
  replicaCount: {{ k3s_apps_ingress_nodes | length }}

  affinity:
    nodeAffinity:
      requiredDuringSchedulingIgnoredDuringExecution:
        nodeSelectorTerms:
          - matchExpressions:
              - key: kubernetes.io/hostname
                operator: In
                values: {{ k3s_apps_ingress_nodes | to_json }}
    podAntiAffinity:
      requiredDuringSchedulingIgnoredDuringExecution:
        - topologyKey: kubernetes.io/hostname
          labelSelector:
            matchLabels:
              app.kubernetes.io/name: ingress-nginx
              app.kubernetes.io/instance: ingress-nginx
              app.kubernetes.io/component: controller

  # Keeps one replica serving during node drains.
  minAvailable: 1

  priorityClassName: system-cluster-critical

  # Served for any TLS host without its own secretName — the public ingresses
  # rely on this (see the "Let's Encrypt wildcard" tasks).
  extraArgs:
    default-ssl-certificate: "ingress-nginx/{{ k3s_apps_public_cert_name }}-tls"
    # Failover without a gap: on SIGTERM the controller reports not-ready but
    # nginx keeps serving for this long. The fast readiness probe below lets
    # MetalLB move the LoadBalancer IP to the other replica's node within ~5s,
    # well before nginx stops listening. Without it, nginx closed at once and
    # the IP only moved ~25s later (both LAN and public down meanwhile).
    shutdown-grace-period: "15"

  readinessProbe:
    periodSeconds: 2
    failureThreshold: 2

  image:
    tag: "v1.12.1"

  config:
    allow-snippet-annotations: "true"
    annotations-risk-level: "Critical"
    use-forwarded-headers: "true"
    compute-full-forwarded-for: "true"
    use-gzip: "true"
    gzip-level: "5"
    gzip-types: "application/javascript application/json application/rss+xml application/vnd.ms-fontobject application/x-javascript application/xhtml+xml application/xml font/opentype image/svg+xml image/x-icon text/css text/javascript text/plain text/xml"
    upstream-keepalive-connections: "50"
    upstream-keepalive-time: "1h"
    upstream-keepalive-requests: "10000"
    proxy-buffering: "off"
    proxy-request-buffering: "off"
    proxy-buffer-size: "50k"
    proxy-body-size: "0"
    keep-alive: "75"
    keep-alive-requests: "10000"
    proxy-read-timeout: "3600"
    proxy-send-timeout: "3600"
    proxy-connect-timeout: "10"
    worker-processes: "auto"
    worker-connections: "8192"
    max-worker-connections: "16384"
    ssl-session-cache: "shared:SSL:50m"
    ssl-session-timeout: "10m"
    ssl-protocols: "TLSv1.2 TLSv1.3"
    ssl-ciphers: "ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305"
    use-http2: "true"
    tcp-nodelay: "on"
    # Real-client-IP: only Cloudflare's edge IPs are trusted to supply
    # X-Forwarded-For (used for *.darkestserver.com). LAN clients on
    # *.homelab.lan connect directly with no proxy in front, so their raw
    # socket IP is already correct and must NOT be in this CIDR list —
    # trusting a client's own subnet here makes nginx read a header the
    # client itself can spoof/omit, which is what caused every LAN request
    # to misreport as 192.168.10.200 instead of the real client IP.
    enable-real-ip: "true"
    forwarded-for-header: "X-Forwarded-For"
    proxy-real-ip-cidr: "173.245.48.0/20,103.21.244.0/22,103.22.200.0/22,103.31.4.0/22,141.101.64.0/18,108.162.192.0/18,190.93.240.0/20,188.114.96.0/20,197.234.240.0/22,198.41.128.0/17,162.158.0.0/15,104.16.0.0/13,104.24.0.0/14,172.64.0.0/13,131.0.72.0/22"
    hsts: "true"
    hsts-max-age: "31536000"
    hsts-include-subdomains: "false"
    http-snippet: |
      proxy_cache_path /tmp/nginx-cache levels=1:2 keys_zone=ingress_cache:10m max_size=5g inactive=7d use_temp_path=off;

  metrics:
    enabled: true
    port: 10254
    service:
      annotations:
        prometheus.io/scrape: "true"
        prometheus.io/port: "10254"

  # hostNetwork + hostPort means only one pod can bind 80/443 per node, so a
  # surge pod would sit in Pending. Replace one pod at a time instead; the
  # other replica keeps serving while it restarts.
  updateStrategy:
    type: RollingUpdate
    rollingUpdate:
      maxSurge: 0
      maxUnavailable: 1

  hostNetwork: true

  hostPort:
    enabled: true
    ports:
      http: 80
      https: 443
      metrics: 10254

  resources:
    requests:
      cpu: "200m"
      memory: "256Mi"
    limits:
      cpu: "2000m"
      memory: "1Gi"

  service:
    type: LoadBalancer
    loadBalancerIP: {{ k3s_apps_ingress_nginx_ip | default('192.168.10.210') }}
    # Cluster (the chart default) lets any node's kube-proxy receive and
    # SNAT-forward traffic to the pod, replacing the real client IP with
    # whichever node happens to be the MetalLB L2 speaker for this IP —
    # this was the cause of every request logging as 192.168.10.200
    # (gateway-server, the elected speaker) instead of the real client.
    # Local preserves the original source IP by only routing to pods on
    # the node that's actually announcing the LoadBalancer IP.
    externalTrafficPolicy: Local
    ports:
      http: 80
      https: 443

  ingressClassResource:
    name: nginx
    enabled: true
    default: false

  watchIngressWithoutClass: false
  enableAnnotationValidation: true
