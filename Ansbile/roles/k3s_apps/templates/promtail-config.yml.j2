server:
  http_listen_port: 9080
  grpc_listen_port: 0

positions:
  # Persisted on the host via hostPath so positions survive pod restarts and
  # node reboots — otherwise promtail replays old logs from the start and Loki
  # rejects them as "entry too far behind" (counted as ingester_error drops).
  filename: /var/lib/promtail/positions.yaml

clients:
  - url: http://{{ hostvars['monitoring-server']['ansible_host'] }}:3100/loki/api/v1/push

scrape_configs:
  - job_name: k3s-containers
    kubernetes_sd_configs:
      - role: pod
    pipeline_stages:
      - cri: {}
    relabel_configs:
      - source_labels: [__meta_kubernetes_pod_node_name]
        target_label: host
      - source_labels: [__meta_kubernetes_namespace]
        target_label: namespace
      - source_labels: [__meta_kubernetes_pod_name]
        target_label: pod
      - source_labels: [__meta_kubernetes_pod_container_name]
        target_label: container
      - source_labels: [__meta_kubernetes_pod_label_app]
        target_label: job
      - source_labels: [__meta_kubernetes_pod_uid, __meta_kubernetes_pod_container_name]
        target_label: __path__
        separator: /
        regex: (.*)/(.*)
        replacement: /var/log/pods/*$1/*$2/*.log

  - job_name: system
    static_configs:
      - targets:
          - localhost
        labels:
          job: varlogs
          host: ${NODE_NAME}
          __path__: /var/log/*.log
