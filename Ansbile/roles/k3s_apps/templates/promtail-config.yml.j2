server:
  http_listen_port: 9080
  grpc_listen_port: 0

positions:
  filename: /tmp/positions.yaml

clients:
  - url: http://{{ hostvars['monitoring-server']['ansible_host'] }}:3100/loki/api/v1/push

scrape_configs:
  - job_name: k3s-containers
    static_configs:
      - targets:
          - localhost
        labels:
          host: media-server
          __path__: /var/log/pods/*/*/*.log
    pipeline_stages:
      - cri: {}

  - job_name: docker-containers
    static_configs:
      - targets:
          - localhost
        labels:
          host: media-server
          __path__: /var/lib/docker/containers/*/*.log
    pipeline_stages:
      - json:
          expressions:
            stream: stream
            log: log
      - labels:
          stream:
      - output:
          source: log

  - job_name: system
    static_configs:
      - targets:
          - localhost
        labels:
          job: varlogs
          host: media-server
          __path__: /var/log/*.log
