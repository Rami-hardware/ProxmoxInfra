{% set k3s_apps_alloy_config = lookup('ansible.builtin.template', 'alloy-config.alloy.j2') %}
---
# Grafana Alloy: the log agent on every node (replaced Promtail, end of life
# in 2026). It tails container logs (/var/log/pods) and the host's
# /var/log/*.log and pushes them to Loki with the same labels Promtail used
# (host, namespace, pod, container, job), so queries, log metrics and
# dashboards did not change.
apiVersion: v1
kind: ServiceAccount
metadata:
  name: alloy
  namespace: monitoring
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: alloy
rules:
  - apiGroups: [""]
    resources: [nodes, pods]
    verbs: [get, list, watch]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: alloy
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: alloy
subjects:
  - kind: ServiceAccount
    name: alloy
    namespace: monitoring
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: alloy-config
  namespace: monitoring
data:
  config.alloy: |
    {{ k3s_apps_alloy_config | indent(4) }}
---
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: alloy
  namespace: monitoring
  labels:
    app: alloy
spec:
  selector:
    matchLabels:
      app: alloy
  template:
    metadata:
      labels:
        app: alloy
      annotations:
        # Restart the pods when the config changes.
        checksum/config: "{{ k3s_apps_alloy_config | hash('sha256') }}"
    spec:
      serviceAccountName: alloy
      # Host network like the old Promtail: the agent stays outside the mesh
      # and its metrics port is reachable on every node IP.
      hostNetwork: true
      dnsPolicy: ClusterFirstWithHostNet
      tolerations:
        - key: node-role.kubernetes.io/control-plane
          effect: NoSchedule
      containers:
        - name: alloy
          image: grafana/alloy:{{ k3s_apps_alloy_version }}
          args:
            - run
            - /etc/alloy/config.alloy
            - --storage.path=/var/lib/alloy/data
            - --server.http.listen-addr=0.0.0.0:12345
            # AdGuard sinks stats.grafana.org to 0.0.0.0, so the usage report
            # hits the local ingress cert and logs an x509 error that trips
            # TLSOrCertificateErrorInLogs.
            - --disable-reporting
          env:
            - name: NODE_NAME
              valueFrom:
                fieldRef:
                  fieldPath: spec.nodeName
          ports:
            - name: http
              containerPort: 12345
          readinessProbe:
            httpGet:
              path: /-/ready
              port: http
            periodSeconds: 10
          # Reads root-owned files under /var/log.
          securityContext:
            runAsUser: 0
            readOnlyRootFilesystem: true
          volumeMounts:
            - name: config
              mountPath: /etc/alloy
              readOnly: true
            - name: varlog
              mountPath: /var/log
              readOnly: true
            - name: storage
              mountPath: /var/lib/alloy
          resources:
            requests:
              memory: "96Mi"
              cpu: "10m"
            limits:
              memory: "384Mi"
              cpu: "300m"
      volumes:
        - name: config
          configMap:
            name: alloy-config
        - name: varlog
          hostPath:
            path: /var/log
        - name: storage
          hostPath:
            path: /var/lib/alloy
            type: DirectoryOrCreate
