---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ item.namespace }}
{% set ns_needs_privileged = (
    k3s_apps_list | selectattr('namespace', 'equalto', item.namespace) | selectattr('gpu', 'defined') | selectattr('gpu') | list | length > 0
  ) or (
    k3s_apps_list | selectattr('namespace', 'equalto', item.namespace) | selectattr('privileged', 'defined') | selectattr('privileged') | list | length > 0
  ) %}
{% set ns_needs_istio = item.namespace in (k3s_apps_istio_injected_namespaces | default([])) %}
{% if ns_needs_privileged or ns_needs_istio %}
  labels:
{% if ns_needs_privileged %}
    pod-security.kubernetes.io/enforce: privileged
{% endif %}
{% if ns_needs_istio %}
    istio-injection: enabled
{% endif %}
{% endif %}
---
# Every app gets its own ServiceAccount instead of sharing the namespace
# "default" SA. Without this a compromised app inherits whatever the default
# SA can do, and its token is mounted into the pod for free. The token is not
# mounted unless the app actually talks to the Kubernetes API
# (service_account_mount_token: true).
apiVersion: v1
kind: ServiceAccount
metadata:
  name: {{ item.service_account | default(item.name) }}
  namespace: {{ item.namespace }}
automountServiceAccountToken: {{ item.service_account_mount_token | default(false) | lower }}
{% if not (item.skip_pv | default(false)) %}
---
apiVersion: v1
kind: PersistentVolume
metadata:
  name: {{ item.name }}-config-pv
spec:
  capacity:
    storage: 1Gi
  accessModes:
    - ReadWriteOnce
  persistentVolumeReclaimPolicy: Retain
  storageClassName: ""
  hostPath:
    path: {{ item.config_path }}
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: {{ item.name }}-config-pvc
  namespace: {{ item.namespace }}
spec:
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: 1Gi
  volumeName: {{ item.name }}-config-pv
  storageClassName: ""
{% endif %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ item.name }}
  namespace: {{ item.namespace }}
spec:
  replicas: {{ item.replicas | default(1) }}
{% set uses_host_port = (item.host_network | default(false)) or
    (item.host_port is defined) or
    (item.extra_ports | default([]) | selectattr('host_port', 'defined') | list | length > 0) %}
  strategy:
{% if uses_host_port %}
    type: Recreate
{% else %}
    type: RollingUpdate
    rollingUpdate:
      maxSurge: 1
      maxUnavailable: 0
{% endif %}
  selector:
    matchLabels:
      app: {{ item.name }}
  template:
    metadata:
      labels:
        app: {{ item.name }}
{% if item.istio_exclude_ports is defined %}
      annotations:
        traffic.sidecar.istio.io/excludeInboundPorts: "{{ item.istio_exclude_ports | join(',') }}"
        traffic.sidecar.istio.io/excludeOutboundPorts: "{{ item.istio_exclude_ports | join(',') }}"
{% endif %}
    spec:
{% if item.host_network | default(false) %}
      hostNetwork: true
{% endif %}
{% if item.dns_policy is defined %}
      dnsPolicy: {{ item.dns_policy }}
{% if item.dns_nameservers is defined %}
      dnsConfig:
        nameservers:
{% for ns in item.dns_nameservers %}
          - "{{ ns }}"
{% endfor %}
        searches:
          - "{{ item.namespace }}.svc.cluster.local"
          - "svc.cluster.local"
          - "cluster.local"
{% endif %}
{% elif item.host_network | default(false) %}
      dnsPolicy: ClusterFirstWithHostNet
{% endif %}
{% if item.host_pid | default(false) %}
      hostPID: true
{% endif %}
      serviceAccountName: {{ item.service_account | default(item.name) }}
{% if not (item.enable_service_links | default(true)) %}
      enableServiceLinks: false
{% endif %}
      nodeSelector:
        kubernetes.io/hostname: {{ item.target_node }}
      containers:
        - name: {{ item.name }}
          image: {{ item.image }}
{% if item.gpu | default(false) or item.privileged | default(false) %}
          securityContext:
            privileged: true
{% endif %}
{% if item.args | default([]) | length > 0 %}
          args:
{% for arg in item.args %}
            - "{{ arg }}"
{% endfor %}
{% endif %}
{% if not (item.host_network | default(false)) and (item.port is defined or item.extra_ports | default([]) | length > 0) %}
          ports:
{% if item.port is defined %}
            - containerPort: {{ item.port }}
{% if item.host_port is defined %}
              hostPort: {{ item.host_port }}
{% endif %}
{% endif %}
{% for ep in item.extra_ports | default([]) %}
            - containerPort: {{ ep.port }}
{% if ep.protocol is defined %}
              protocol: {{ ep.protocol }}
{% endif %}
{% if ep.host_port is defined %}
              hostPort: {{ ep.host_port }}
{% endif %}
{% endfor %}
{% endif %}
{% if item.env | default([]) | length > 0 %}
          env:
{% for env_var in item.env %}
            - name: {{ env_var.name }}
              value: "{{ env_var.value }}"
{% endfor %}
{% endif %}
{% set has_mounts = (not (item.skip_pv | default(false))) or (item.extra_volumes | default([]) | length > 0) or (item.gpu | default(false)) %}
{% if has_mounts %}
          volumeMounts:
{% if not (item.skip_pv | default(false)) %}
            - name: config
              mountPath: {{ item.config_mount }}
{% endif %}
{% for vol in item.extra_volumes | default([]) %}
            - name: {{ vol.name }}
              mountPath: {{ vol.mount_path }}
{% if vol.read_only | default(false) %}
              readOnly: true
{% endif %}
{% endfor %}
{% if item.gpu | default(false) %}
            - name: dri
              mountPath: /dev/dri
{% endif %}
{% endif %}
          resources:
            requests:
              memory: "{{ item.memory_request }}"
              cpu: "{{ item.cpu_request }}"
            limits:
              memory: "{{ item.memory_limit }}"
              cpu: "{{ item.cpu_limit }}"
{% if item.liveness_probe is defined %}
          livenessProbe:
            httpGet:
              path: {{ item.liveness_probe.path }}
              port: {{ item.liveness_probe.port | default(item.port) }}
            initialDelaySeconds: {{ item.liveness_probe.initial_delay_seconds | default(10) }}
            periodSeconds: {{ item.liveness_probe.period_seconds | default(30) }}
            timeoutSeconds: {{ item.liveness_probe.timeout_seconds | default(5) }}
            failureThreshold: {{ item.liveness_probe.failure_threshold | default(3) }}
{% endif %}
{% if item.readiness_probe is defined %}
          readinessProbe:
            httpGet:
              path: {{ item.readiness_probe.path }}
              port: {{ item.readiness_probe.port | default(item.port) }}
            initialDelaySeconds: {{ item.readiness_probe.initial_delay_seconds | default(5) }}
            periodSeconds: {{ item.readiness_probe.period_seconds | default(10) }}
            timeoutSeconds: {{ item.readiness_probe.timeout_seconds | default(5) }}
            failureThreshold: {{ item.readiness_probe.failure_threshold | default(3) }}
{% endif %}
{% if has_mounts %}
      volumes:
{% if not (item.skip_pv | default(false)) %}
        - name: config
          persistentVolumeClaim:
            claimName: {{ item.name }}-config-pvc
{% endif %}
{% for vol in item.extra_volumes | default([]) %}
        - name: {{ vol.name }}
          hostPath:
            path: {{ vol.host_path }}
{% if vol.host_path_type is defined %}
            type: {{ vol.host_path_type }}
{% endif %}
{% endfor %}
{% if item.gpu | default(false) %}
        - name: dri
          hostPath:
            path: /dev/dri
{% endif %}
{% endif %}
{% if item.port is defined and item.node_port is defined %}
---
apiVersion: v1
kind: Service
metadata:
  name: {{ item.name }}
  namespace: {{ item.namespace }}
spec:
  type: NodePort
{% if item.external_ip is defined %}
  externalIPs:
    - {{ item.external_ip }}
{% endif %}
  selector:
    app: {{ item.name }}
  ports:
    - name: http
      port: {{ item.port }}
      targetPort: {{ item.port }}
      nodePort: {{ item.node_port }}
{% for sp in item.service_ports | default([]) %}
    - port: {{ sp.port }}
      targetPort: {{ sp.port }}
      nodePort: {{ sp.node_port }}
{% if sp.protocol is defined %}
      protocol: {{ sp.protocol }}
{% endif %}
{% endfor %}
{% for ep in item.extra_ports | default([]) if ep.node_port is defined %}
    - name: {{ ep.name | default('p-' ~ ep.port ~ '-' ~ (ep.protocol | default('tcp') | lower)) }}
      port: {{ ep.port }}
      targetPort: {{ ep.port }}
      nodePort: {{ ep.node_port }}
{% if ep.protocol is defined %}
      protocol: {{ ep.protocol }}
{% endif %}
{% endfor %}
{% endif %}
