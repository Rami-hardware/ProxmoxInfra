---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ item.namespace }}
{% set ns_needs_privileged = (
    k3s_apps_list | selectattr('namespace', 'equalto', item.namespace) | selectattr('gpu', 'defined') | selectattr('gpu') | list | length > 0
  ) or (
    k3s_apps_list | selectattr('namespace', 'equalto', item.namespace) | selectattr('privileged', 'defined') | selectattr('privileged') | list | length > 0
  ) %}
{% if ns_needs_privileged %}
  labels:
    pod-security.kubernetes.io/enforce: privileged
{% endif %}
{% if not (item.skip_pv | default(false)) %}
---
apiVersion: v1
kind: PersistentVolume
metadata:
  name: {{ item.name }}-config-pv
spec:
  capacity:
    storage: 1Gi
  accessModes:
    - ReadWriteOnce
  persistentVolumeReclaimPolicy: Retain
  storageClassName: ""
  hostPath:
    path: {{ item.config_path }}
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: {{ item.name }}-config-pvc
  namespace: {{ item.namespace }}
spec:
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: 1Gi
  volumeName: {{ item.name }}-config-pv
  storageClassName: ""
{% endif %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ item.name }}
  namespace: {{ item.namespace }}
spec:
  replicas: {{ item.replicas | default(1) }}
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxSurge: 1
      maxUnavailable: 0
  selector:
    matchLabels:
      app: {{ item.name }}
  template:
    metadata:
      labels:
        app: {{ item.name }}
    spec:
{% if item.host_network | default(false) %}
      hostNetwork: true
      dnsPolicy: Default
{% elif item.dns_policy is defined %}
      dnsPolicy: {{ item.dns_policy }}
{% if item.dns_nameservers is defined %}
      dnsConfig:
        nameservers:
{% for ns in item.dns_nameservers %}
          - "{{ ns }}"
{% endfor %}
{% endif %}
{% endif %}
{% if item.host_pid | default(false) %}
      hostPID: true
{% endif %}
{% if item.service_account is defined %}
      serviceAccountName: {{ item.service_account }}
{% endif %}
      nodeSelector:
        kubernetes.io/hostname: {{ item.target_node }}
      containers:
        - name: {{ item.name }}
          image: {{ item.image }}
{% if item.gpu | default(false) or item.privileged | default(false) %}
          securityContext:
            privileged: true
{% endif %}
{% if item.args | default([]) | length > 0 %}
          args:
{% for arg in item.args %}
            - "{{ arg }}"
{% endfor %}
{% endif %}
{% if item.port is defined or item.extra_ports | default([]) | length > 0 %}
          ports:
{% if item.port is defined %}
            - containerPort: {{ item.port }}
{% endif %}
{% for ep in item.extra_ports | default([]) %}
            - containerPort: {{ ep.port }}
{% endfor %}
{% endif %}
{% if item.env | default([]) | length > 0 %}
          env:
{% for env_var in item.env %}
            - name: {{ env_var.name }}
              value: "{{ env_var.value }}"
{% endfor %}
{% endif %}
{% set has_mounts = (not (item.skip_pv | default(false))) or (item.extra_volumes | default([]) | length > 0) or (item.gpu | default(false)) %}
{% if has_mounts %}
          volumeMounts:
{% if not (item.skip_pv | default(false)) %}
            - name: config
              mountPath: {{ item.config_mount }}
{% endif %}
{% for vol in item.extra_volumes | default([]) %}
            - name: {{ vol.name }}
              mountPath: {{ vol.mount_path }}
{% if vol.read_only | default(false) %}
              readOnly: true
{% endif %}
{% endfor %}
{% if item.gpu | default(false) %}
            - name: dri
              mountPath: /dev/dri
{% endif %}
{% endif %}
          resources:
            requests:
              memory: "{{ item.memory_request }}"
              cpu: "{{ item.cpu_request }}"
            limits:
              memory: "{{ item.memory_limit }}"
              cpu: "{{ item.cpu_limit }}"
{% if has_mounts %}
      volumes:
{% if not (item.skip_pv | default(false)) %}
        - name: config
          persistentVolumeClaim:
            claimName: {{ item.name }}-config-pvc
{% endif %}
{% for vol in item.extra_volumes | default([]) %}
        - name: {{ vol.name }}
          hostPath:
            path: {{ vol.host_path }}
{% if vol.host_path_type is defined %}
            type: {{ vol.host_path_type }}
{% endif %}
{% endfor %}
{% if item.gpu | default(false) %}
        - name: dri
          hostPath:
            path: /dev/dri
{% endif %}
{% endif %}
{% if item.port is defined %}
---
apiVersion: v1
kind: Service
metadata:
  name: {{ item.name }}
  namespace: {{ item.namespace }}
spec:
  type: NodePort
  selector:
    app: {{ item.name }}
  ports:
    - port: {{ item.port }}
      targetPort: {{ item.port }}
      nodePort: {{ item.node_port }}
{% for ep in item.extra_ports | default([]) %}
    - port: {{ ep.port }}
      targetPort: {{ ep.port }}
      nodePort: {{ ep.node_port }}
{% endfor %}
{% endif %}
