---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ item.namespace }}
---
apiVersion: v1
kind: PersistentVolume
metadata:
  name: {{ item.name }}-config-pv
spec:
  capacity:
    storage: 1Gi
  accessModes:
    - ReadWriteOnce
  persistentVolumeReclaimPolicy: Retain
  storageClassName: ""
  hostPath:
    path: {{ item.config_path }}
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: {{ item.name }}-config-pvc
  namespace: {{ item.namespace }}
spec:
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: 1Gi
  volumeName: {{ item.name }}-config-pv
  storageClassName: ""
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ item.name }}
  namespace: {{ item.namespace }}
spec:
  replicas: {{ item.replicas | default(1) }}
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxSurge: 1
      maxUnavailable: 0
  selector:
    matchLabels:
      app: {{ item.name }}
  template:
    metadata:
      labels:
        app: {{ item.name }}
    spec:
      nodeSelector:
        kubernetes.io/hostname: {{ item.target_node }}
      containers:
        - name: {{ item.name }}
          image: {{ item.image }}
{% if item.gpu | default(false) %}
          securityContext:
            privileged: true
{% endif %}
          ports:
            - containerPort: {{ item.port }}
          env:
{% for env_var in item.env %}
            - name: {{ env_var.name }}
              value: "{{ env_var.value }}"
{% endfor %}
          volumeMounts:
            - name: config
              mountPath: {{ item.config_mount }}
{% for vol in item.extra_volumes | default([]) %}
            - name: {{ vol.name }}
              mountPath: {{ vol.mount_path }}
{% endfor %}
{% if item.gpu | default(false) %}
            - name: dri
              mountPath: /dev/dri
{% endif %}
          resources:
            requests:
              memory: "{{ item.memory_request }}"
              cpu: "{{ item.cpu_request }}"
            limits:
              memory: "{{ item.memory_limit }}"
              cpu: "{{ item.cpu_limit }}"
      volumes:
        - name: config
          persistentVolumeClaim:
            claimName: {{ item.name }}-config-pvc
{% for vol in item.extra_volumes | default([]) %}
        - name: {{ vol.name }}
          hostPath:
            path: {{ vol.host_path }}
{% endfor %}
{% if item.gpu | default(false) %}
        - name: dri
          hostPath:
            path: /dev/dri
{% endif %}
---
apiVersion: v1
kind: Service
metadata:
  name: {{ item.name }}
  namespace: {{ item.namespace }}
spec:
  type: NodePort
  selector:
    app: {{ item.name }}
  ports:
    - port: {{ item.port }}
      targetPort: {{ item.port }}
      nodePort: {{ item.node_port }}
