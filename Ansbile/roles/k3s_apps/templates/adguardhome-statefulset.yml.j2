---
apiVersion: v1
kind: Namespace
metadata:
  name: adguard
---
# Headless service — required by StatefulSet serviceName for stable pod DNS identity
apiVersion: v1
kind: Service
metadata:
  name: adguard
  namespace: adguard
  labels:
    app: adguard-home
spec:
  clusterIP: None
  selector:
    app: adguard-home
  ports:
    - name: dns-udp
      port: 53
      protocol: UDP
    - name: dns-tcp
      port: 53
      protocol: TCP
    - name: http
      port: 80
      protocol: TCP
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: adguard-statefulset
  namespace: adguard
spec:
  serviceName: "adguard"
  replicas: 2
  selector:
    matchLabels:
      app: adguard-home
  template:
    metadata:
      labels:
        app: adguard-home
    spec:
      affinity:
        podAntiAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            - labelSelector:
                matchExpressions:
                  - key: app
                    operator: In
                    values:
                      - adguard-home
              topologyKey: "kubernetes.io/hostname"
      containers:
        - name: adguard-home
          image: adguard/adguardhome:latest
          ports:
            - containerPort: 53
              name: dns
              hostPort: 53
              protocol: UDP
            - containerPort: 3000
              name: http-initial
            - containerPort: 80
              name: http
              hostPort: 5380
              protocol: TCP
          volumeMounts:
            - name: adguard-data
              mountPath: /opt/adguardhome/work/
            - name: adguard-config
              mountPath: /opt/adguardhome/conf/
          resources:
            requests:
              memory: "64Mi"
              cpu: "25m"
            limits:
              memory: "256Mi"
              cpu: "200m"
  volumeClaimTemplates:
    - metadata:
        name: adguard-data
      spec:
        accessModes: ["ReadWriteOnce"]
        resources:
          requests:
            storage: 1Gi
        storageClassName: "local-path"
    - metadata:
        name: adguard-config
      spec:
        accessModes: ["ReadWriteOnce"]
        resources:
          requests:
            storage: 1Gi
        storageClassName: "local-path"
---
# NodePort service — exposes setup wizard externally
apiVersion: v1
kind: Service
metadata:
  name: adguard-home
  namespace: adguard
spec:
  type: NodePort
  selector:
    app: adguard-home
  ports:
    - port: 3000
      nodePort: 30030
      targetPort: 3000
      protocol: TCP
      name: http-initial
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: adguard-sync-config
  namespace: adguard
data:
  LOG_LEVEL: "info"
  ORIGIN_URL: "http://{{ k3s_apps_adguard_sync_origin_url }}:5380"
  ORIGIN_USERNAME: "{{ k3s_apps_adguard_sync_username }}"
  ORIGIN_PASSWORD: "{{ k3s_apps_adguard_sync_password }}"
  REPLICA1_URL: "http://{{ k3s_apps_adguard_sync_replica_url }}:5380"
  REPLICA1_USERNAME: "{{ k3s_apps_adguard_sync_username }}"
  REPLICA1_PASSWORD: "{{ k3s_apps_adguard_sync_password }}"
  CRON: "*/5 * * * *"
  RUN_ON_START: "true"
  API_PORT: "8080"
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: adguard-sync
  namespace: adguard
spec:
  replicas: 1
  selector:
    matchLabels:
      app: adguard-sync
  template:
    metadata:
      labels:
        app: adguard-sync
    spec:
      containers:
        - name: adguard-sync
          image: ghcr.io/bakito/adguardhome-sync:latest
          envFrom:
            - configMapRef:
                name: adguard-sync-config
          ports:
            - containerPort: 8080
          resources:
            requests:
              memory: "32Mi"
              cpu: "10m"
            limits:
              memory: "128Mi"
              cpu: "100m"
