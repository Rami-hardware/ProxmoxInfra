apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: letsencrypt-dns01
spec:
  acme:
    server: https://acme-v02.api.letsencrypt.org/directory
    privateKeySecretRef:
      name: letsencrypt-dns01-account
    solvers:
      - dns01:
          cloudflare:
            apiTokenSecretRef:
              name: cloudflare-api-token
              key: api-token
        selector:
          dnsZones:
            - "{{ k3s_apps_public_domain }}"
---
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: {{ k3s_apps_public_cert_name }}
  namespace: ingress-nginx
spec:
  secretName: {{ k3s_apps_public_cert_name }}-tls
  issuerRef:
    name: letsencrypt-dns01
    kind: ClusterIssuer
  dnsNames:
    - "{{ k3s_apps_public_domain }}"
    - "*.{{ k3s_apps_public_domain }}"
