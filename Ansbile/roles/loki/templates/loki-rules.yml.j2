# Managed by Ansible (roles/loki) — do not edit on the host.
# Loki only turns log queries into metrics here (recording rules). The ruler
# remote-writes them to Prometheus, where the log alerts live next to every
# other alert (roles/prometheus/templates/prometheus-rules.yml.j2, group
# "logs"). Raw block: LogQL braces must not be read as Jinja.
{% raw %}
groups:
  - name: log-metrics
    interval: 1m
    rules:
      # Every line Loki receives, per container. Its absence means the log
      # pipeline (Alloy -> Loki -> ruler -> Prometheus) is broken.
      - record: log:lines:count5m
        expr: sum by (namespace, container) (count_over_time({job=~".+"} [5m]))

      - record: log:error_lines:count5m
        expr: sum by (namespace, container) (count_over_time({job=~".+", container!~"loki|grafana|istio-proxy"} |= "error" [5m]))

      - record: log:tls_error_lines:count15m
        expr: sum by (namespace, container) (count_over_time({job=~".+", container!~"loki|grafana|istio-proxy"} |~ "(?i)x509.*(fail|error|invalid)|certificate.*expired|tls.*handshake.*(fail|error|reset)" [15m]))

      - record: log:media_import_failures:count15m
        expr: sum by (container) (count_over_time({namespace="media", container=~"sonarr|radarr"} |~ "(?i)failed to import|download failed" [15m]))

      - record: log:tempo_lines:count10m
        expr: sum(count_over_time({namespace="istio-system", container="tempo"} [10m]))
{% endraw %}
