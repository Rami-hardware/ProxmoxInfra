auth_enabled: false

server:
  http_listen_port: {{ loki_http_port }}

common:
  path_prefix: /loki
  replication_factor: 1
  ring:
    instance_addr: 127.0.0.1
    kvstore:
      store: inmemory

storage_config:
  boltdb_shipper:
    active_index_directory: /loki/index
    cache_location: /loki/boltdb-cache
  filesystem:
    directory: /loki/chunks

schema_config:
  configs:
    - from: 2020-10-24
      store: boltdb-shipper
      object_store: filesystem
      schema: v11
      index:
        prefix: index_
        period: 24h

limits_config:
  allow_structured_metadata: false
  reject_old_samples: {{ loki_reject_old_samples | lower }}
  reject_old_samples_max_age: {{ loki_reject_old_samples_max_age }}

# LogQL alerting — rules rendered to /opt/docker/loki/rules (mounted at
# /etc/loki/rules) by roles/loki; alerts go to the same Alertmanager →
# alert-forwarder → Discord chain as the Prometheus rules.
ruler:
  enable_api: true
  rule_path: /loki/rules
  alertmanager_url: http://{{ hostvars['monitoring-server']['ansible_host'] }}:9093
  enable_alertmanager_v2: true
  ring:
    kvstore:
      store: inmemory
  storage:
    type: local
    local:
      directory: /etc/loki/rules
