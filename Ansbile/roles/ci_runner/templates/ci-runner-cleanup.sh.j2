#!/bin/bash
# Managed by Ansible (roles/ci_runner). Runs weekly from ci-runner-cleanup.timer.
# Each runner auto-update leaves a full copy of the previous version
# (bin.<ver>, externals.<ver>, ~700 MB) plus its download in _work/_update.
set -euo pipefail
for dir in {{ ci_runner_cleanup_dirs | join(' ') }}; do
  [ -d "$dir" ] || continue
  live_bin=$(readlink -f "$dir/bin")
  live_ext=$(readlink -f "$dir/externals")
  for d in "$dir"/bin.* "$dir"/externals.*; do
    [ -d "$d" ] || continue
    [ "$d" = "$live_bin" ] || [ "$d" = "$live_ext" ] || rm -rf "$d"
  done
  rm -rf "$dir/_work/_update" "$dir"/actions-runner-linux-*.tar.gz
done
# Dangling layers from CI image builds.
docker image prune -f >/dev/null
apt-get clean
