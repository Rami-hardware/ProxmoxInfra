        keep-file: "true"
        mode: "non-blocking"
    ports:
{% for port in nginx_ports %}
      - "{{ port }}"
{% endfor %}
    volumes:
      - "{{ nginx_default_val }}"
    restart: unless-stopped
{% endif %}

{% if 'fail2ban' in docker_apps_enabled %}
