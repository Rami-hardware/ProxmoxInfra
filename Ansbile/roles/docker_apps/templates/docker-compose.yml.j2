version: "3.9"
services:
{% if 'crowdsec' in docker_apps_enabled %}
  crowdsec:
    image: crowdsecurity/crowdsec:latest
    container_name: crowdsec
    volumes:
      - /opt/docker/crowdsec/data:/var/lib/crowdsec/data
      - /opt/docker/crowdsec/config:/etc/crowdsec
    restart: unless-stopped
    networks:
      - nginx_network

  crowdsec-nginx-bouncer:
    image: crowdsecurity/crowdsec-nginx-bouncer:latest
    container_name: crowdsec-nginx-bouncer
    depends_on:
      - crowdsec
    environment:
      - API_URL=http://crowdsec:8080
      - API_KEY_FILE=/etc/crowdsec/bouncer_api_key
    volumes:
      - /opt/docker/crowdsec/bouncer:/etc/crowdsec
    restart: unless-stopped
    networks:
      - nginx_network
{% endif %}

{% if 'adguardhome' in docker_apps_enabled %}
  adguardhome:
    image: adguard/adguardhome
    container_name: adguardhome
    logging:
      driver: loki
      options:
        loki-url: "http://192.168.1.203:3100/loki/api/v1/push"
        loki-retries: "2"
        loki-max-backoff: "800ms"
        loki-timeout: "1s"
        keep-file: "true"
        mode: "non-blocking"
    ports:
{% for port in adguardhome_ports %}
      - "{{ port }}"
{% endfor %}
    volumes:
      - "{{ adguardhome_volume_config_dir }}"
      - "{{ adguardhome_volume_work_dir }}"
    restart: unless-stopped
{% endif %}

{% if 'promtail' in docker_apps_enabled %}
  promtail:
    image: grafana/promtail:latest
    container_name: promtail
    volumes:
        - "/var/log:/var/log"
        - "/opt/services/promtail:/etc/promtail"
    command: -config.file=/etc/promtail/config.yml
    restart: unless-stopped
{% endif %}

{% if 'watchtower' in docker_apps_enabled %}
  watchtower:
    image: containrrr/watchtower
    container_name: watchtower
    logging:
      driver: loki
      options:
        loki-url: "http://192.168.1.203:3100/loki/api/v1/push"
        loki-retries: "2"
        loki-max-backoff: "800ms"
        loki-timeout: "1s"
        keep-file: "true"
        mode: "non-blocking"
    volumes:
      - "{{ watchtower_run }}"
    command: --cleanup --interval 3600
    restart: unless-stopped
{% endif %}

{% if 'nginx' in docker_apps_enabled %}
  nginx:
    image: nginx:latest
    container_name: nginx
