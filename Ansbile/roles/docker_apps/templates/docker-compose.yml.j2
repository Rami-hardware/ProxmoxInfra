        loki-timeout: "1s"
        keep-file: "true"
        mode: "non-blocking"
    container_name: node-exporter
    command:
      - '--path.rootfs=/host'
    volumes:
      - "/:/host:ro,rslave"
    ports:
      - "9100:9100"
    pid: "host"
    restart: unless-stopped
{% endif %}


{% if 'nextpvr' in docker_apps_enabled %}
  nextpvr:
    image: nextpvr/nextpvr_amd64:stable # Use nextpvr/nextpvr_arm32v7:stable for ARM devices like Raspberry Pi
    container_name: nextpvr
    restart: unless-stopped
    ports:
      - "8866:8866" # NextPVR web interface
    volumes:
      - /opt/nextpvr/config:/config # Persistent storage for NextPVR configuration
      - /opt/nextpvr/recordings:/recordings # Storage for recorded TV shows
      - /opt/nextpvr/buffer:/buffer # Storage for live TV buffer
    environment:
      - PUID=1000 # User ID for permissions (adjust to your user's PUID)
      - PGID=1000 # Group ID for permissions (adjust to your user's PGID)
      - TZ=Europe/London # Set your timezone

{% endif %}
