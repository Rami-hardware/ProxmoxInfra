version: "3.9"
services:
{% if 'crowdsec' in docker_apps_enabled %}
  crowdsec:
    image: crowdsecurity/crowdsec:latest
    container_name: crowdsec
    restart: unless-stopped
    dns:
      - 1.1.1.1
      - 8.8.8.8
    volumes:
      - /opt/docker/crowdsec/data:/var/lib/crowdsec/data
      - /opt/docker/crowdsec/config:/etc/crowdsec
      - /opt/docker/nginx/logs:/var/log/nginx:ro

    ports:
      - "8080:8080"
{% endif %}
{% if 'crowdsec-nginx-bouncer' in docker_apps_enabled %}
  crowdsec-nginx-bouncer:
    image: crowdsecurity/openresty:latest
    container_name: crowdsec-nginx-bouncer
    restart: unless-stopped
    depends_on:
      - crowdsec
      - nginx

    environment:
      CROWDSEC_BOUNCER_API_KEY_FILE: /run/secrets/crowdsec_nginx_bouncer_key
      CROWDSEC_AGENT_HOST: crowdsec:8080
      CROWDSEC_LOG_LEVEL: info
    secrets:
      - source: crowdsec_nginx_bouncer_key
        target: crowdsec_nginx_bouncer_key
{% endif %}
{% if 'adguardhome' in docker_apps_enabled %}
  adguardhome:
    image: adguard/adguardhome
    container_name: adguardhome
    network_mode: host
    logging:
      driver: loki
      options:
        loki-url: "http://192.168.1.203:3100/loki/api/v1/push"
        loki-retries: "2"
        loki-max-backoff: "800ms"
        loki-timeout: "1s"
        keep-file: "true"
        mode: "non-blocking"
    volumes:
      - "{{ adguardhome_volume_config_dir }}"
      - "{{ adguardhome_volume_work_dir }}"
    restart: unless-stopped
{% endif %}

{% if 'promtail' in docker_apps_enabled %}
  promtail:
    image: grafana/promtail:latest
    container_name: promtail
    volumes:
      - "/var/log:/var/log"
      - "/opt/services/promtail:/etc/promtail"
    env_file:
      - /opt/services/promtail/.env   # <-- loads HOSTNAME
    command: -config.file=/etc/promtail/config.yml -config.expand-env=true
    restart: unless-stopped
{% endif %}

{% if 'cadvisor' in docker_apps_enabled %}
  cadvisor:
    image: gcr.io/cadvisor/cadvisor:v0.49.1
    container_name: cadvisor
    restart: unless-stopped
    ports:
      - "8081:8080"
    volumes:
      - /:/rootfs:ro
      - /var/run:/var/run:ro
      - /sys:/sys:ro
      - /var/lib/docker/:/var/lib/docker:ro
    privileged: true
    #cgroupns: host
{% endif %}

{% if 'nginx' in docker_apps_enabled %}
  nginx:
    image: nginx:latest
    container_name: nginx
    restart: unless-stopped

    ports:
{% for port in nginx_ports %}
      - "{{ port }}"
{% endfor %}

    volumes:
{% for vol in nginx_volumes %}
      - "{{ vol }}"
{% endfor %}
{% endif %}


{% if 'fail2ban' in docker_apps_enabled %}
  fail2ban:
    image: crazymax/fail2ban
    container_name: fail2ban
    network_mode: host
    volumes:
      - "{{ fail2ban_var_path }}"
      - "{{ fail2ban_data_path }}"
