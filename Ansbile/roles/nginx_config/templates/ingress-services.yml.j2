---
# ──────────────────────────────────────────────────────────────────────────────
# CA cert endpoint  (HTTP only · http://ca.homelab.lan/ca.crt)
# Visit from any device to download and trust the local CA once.
# ──────────────────────────────────────────────────────────────────────────────
apiVersion: v1
kind: ConfigMap
metadata:
  name: ca-cert-file
  namespace: network
data:
  ca.crt: |
    {{ nginx_config_local_ca_crt.content | b64decode | indent(4) }}
  nginx.conf: |
    server {
      listen 80;
      root /usr/share/nginx/html;
      location /ca.crt {
        add_header Content-Type application/x-x509-ca-cert;
        add_header Content-Disposition 'attachment; filename="homelab-ca.crt"';
      }
    }
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: ca-cert
  namespace: network
spec:
  replicas: 1
  selector:
    matchLabels:
      app: ca-cert
  template:
    metadata:
      labels:
        app: ca-cert
    spec:
      containers:
        - name: nginx
          image: nginx:alpine
          ports:
            - containerPort: 80
          volumeMounts:
            - name: cert
              mountPath: /usr/share/nginx/html/ca.crt
              subPath: ca.crt
            - name: cert
              mountPath: /etc/nginx/conf.d/default.conf
              subPath: nginx.conf
          resources:
            requests:
              cpu: "10m"
              memory: "16Mi"
            limits:
              cpu: "50m"
              memory: "32Mi"
      volumes:
        - name: cert
          configMap:
            name: ca-cert-file
---
apiVersion: v1
kind: Service
metadata:
  name: ca-cert
  namespace: network
spec:
  selector:
    app: ca-cert
  ports:
    - port: 80
      targetPort: 80
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: ca-cert
  namespace: network
spec:
  ingressClassName: nginx
  rules:
    - host: ca.homelab.lan
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: ca-cert
                port:
                  number: 80
---
# ──────────────────────────────────────────────────────────────────────────────
# Local LAN services  (HTTPS + TLS · host: <name>.<namespace>.lan)
# ──────────────────────────────────────────────────────────────────────────────
{% for svc in nginx_services_local %}
{% set ns = svc.namespace | default('media') %}
# {{ svc.name }} — headless service + endpoints → {{ svc.ip }}:{{ svc.port }}
---
apiVersion: v1
kind: Service
metadata:
  name: {{ svc.name }}-ext
  namespace: {{ ns }}
spec:
  clusterIP: None
  ports:
    - port: {{ svc.port }}
      protocol: TCP
---
apiVersion: v1
kind: Endpoints
metadata:
  name: {{ svc.name }}-ext
  namespace: {{ ns }}
subsets:
  - addresses:
      - ip: {{ svc.ip }}
    ports:
      - port: {{ svc.port }}
        protocol: TCP
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ svc.name }}
  namespace: {{ ns }}
  annotations:
    cert-manager.io/cluster-issuer: homelab-ca-issuer
    nginx.ingress.kubernetes.io/proxy-body-size: "50m"
{% if svc.backend_protocol | default(false) %}
    nginx.ingress.kubernetes.io/backend-protocol: "{{ svc.backend_protocol }}"
{% endif %}
{% if svc.disable_buffering | default(false) %}
    nginx.ingress.kubernetes.io/proxy-request-buffering: "off"
    nginx.ingress.kubernetes.io/proxy-buffering: "off"
{% endif %}
{% if svc.streaming | default(false) %}
    nginx.ingress.kubernetes.io/proxy-buffering: "off"
    nginx.ingress.kubernetes.io/proxy-request-buffering: "off"
    nginx.ingress.kubernetes.io/proxy-read-timeout: "3600"
    nginx.ingress.kubernetes.io/proxy-send-timeout: "3600"
    nginx.ingress.kubernetes.io/proxy-connect-timeout: "10"
    nginx.ingress.kubernetes.io/proxy-body-size: "0"
    nginx.ingress.kubernetes.io/proxy-hide-headers: "X-Accel-Buffering"
{% endif %}
spec:
  ingressClassName: nginx
  tls:
    - hosts:
        - {{ svc.name }}.homelab.lan
      secretName: {{ svc.name }}-tls
  rules:
    - host: {{ svc.name }}.homelab.lan
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: {{ svc.name }}-ext
                port:
                  number: {{ svc.port }}
{% endfor %}
---
# ──────────────────────────────────────────────────────────────────────────────
# Public services  (HTTPS + TLS · host: <name>.darkestserver.com)
# ──────────────────────────────────────────────────────────────────────────────
{% for svc in nginx_services %}
{% set svc_name = svc.k8s_service | default(svc.name) %}
{% set ns = svc.namespace | default('media') %}
# {{ svc.name }} — headless service + endpoints → {{ svc.ip }}:{{ svc.port }}
---
apiVersion: v1
kind: Service
metadata:
  name: {{ svc_name }}-ext
  namespace: {{ ns }}
spec:
  clusterIP: None
  ports:
    - port: {{ svc.port }}
      protocol: TCP
---
apiVersion: v1
kind: Endpoints
metadata:
  name: {{ svc_name }}-ext
  namespace: {{ ns }}
subsets:
  - addresses:
      - ip: {{ svc.ip }}
    ports:
      - port: {{ svc.port }}
        protocol: TCP
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ svc.name }}-public
  namespace: {{ ns }}
  annotations:
    nginx.ingress.kubernetes.io/proxy-body-size: "50m"
{% if svc.disable_buffering | default(false) %}
    nginx.ingress.kubernetes.io/proxy-request-buffering: "off"
    nginx.ingress.kubernetes.io/proxy-buffering: "off"
{% endif %}
{% if svc.streaming | default(false) %}
    nginx.ingress.kubernetes.io/proxy-buffering: "off"
    nginx.ingress.kubernetes.io/proxy-request-buffering: "off"
    nginx.ingress.kubernetes.io/proxy-read-timeout: "3600"
    nginx.ingress.kubernetes.io/proxy-send-timeout: "3600"
    nginx.ingress.kubernetes.io/proxy-connect-timeout: "10"
    nginx.ingress.kubernetes.io/proxy-body-size: "0"
    nginx.ingress.kubernetes.io/proxy-hide-headers: "X-Accel-Buffering"
{% endif %}
spec:
  ingressClassName: nginx
  tls:
    - hosts:
        - {{ svc.name }}.darkestserver.com
      secretName: cloudflare-origin-tls
  rules:
    - host: {{ svc.name }}.darkestserver.com
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: {{ svc_name }}-ext
                port:
                  number: {{ svc.port }}
{% endfor %}
