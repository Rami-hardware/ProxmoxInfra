{% if svc.cache_paths | default([]) | length > 0 %}
    nginx.ingress.kubernetes.io/server-snippet: |
      location ~* ^/({{ svc.cache_paths | map('regex_replace', '^/', '') | join('|') }})/ {
        proxy_buffering on;
