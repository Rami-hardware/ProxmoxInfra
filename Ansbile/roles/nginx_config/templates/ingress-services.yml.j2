---
# ──────────────────────────────────────────────────────────────────────────────
# Local LAN services  (HTTPS + TLS · host: <name>.<namespace>.lan)
# ──────────────────────────────────────────────────────────────────────────────
{% for svc in nginx_services_local %}
{% set ns = svc.namespace | default('media') %}
# {{ svc.name }} — headless service + endpoints → {{ svc.ip }}:{{ svc.port }}
---
apiVersion: v1
kind: Service
metadata:
  name: {{ svc.name }}-ext
  namespace: {{ ns }}
spec:
  clusterIP: None
  ports:
    - port: {{ svc.port }}
      protocol: TCP
---
apiVersion: v1
kind: Endpoints
metadata:
  name: {{ svc.name }}-ext
  namespace: {{ ns }}
subsets:
  - addresses:
      - ip: {{ svc.ip }}
    ports:
      - port: {{ svc.port }}
        protocol: TCP
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ svc.name }}
  namespace: {{ ns }}
  annotations:
    nginx.ingress.kubernetes.io/proxy-body-size: "50m"
{% if svc.disable_buffering | default(false) %}
    nginx.ingress.kubernetes.io/proxy-request-buffering: "off"
    nginx.ingress.kubernetes.io/proxy-buffering: "off"
{% endif %}
{% if svc.streaming | default(false) %}
    nginx.ingress.kubernetes.io/proxy-read-timeout: "3600"
    nginx.ingress.kubernetes.io/proxy-send-timeout: "3600"
    nginx.ingress.kubernetes.io/proxy-connect-timeout: "600"
{% endif %}
spec:
  ingressClassName: nginx
  tls:
    - hosts:
        - {{ svc.name }}.{{ ns }}.lan
      secretName: local-tls
  rules:
    - host: {{ svc.name }}.{{ ns }}.lan
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: {{ svc.name }}-ext
                port:
                  number: {{ svc.port }}
{% endfor %}
---
# ──────────────────────────────────────────────────────────────────────────────
# Public services  (HTTPS + TLS · host: <name>.darkestserver.com)
# ──────────────────────────────────────────────────────────────────────────────
{% for svc in nginx_services %}
{% set svc_name = svc.k8s_service | default(svc.name) %}
{% set ns = svc.namespace | default('media') %}
# {{ svc.name }} — headless service + endpoints → {{ svc.ip }}:{{ svc.port }}
---
apiVersion: v1
kind: Service
metadata:
  name: {{ svc_name }}-ext
  namespace: {{ ns }}
spec:
  clusterIP: None
  ports:
    - port: {{ svc.port }}
      protocol: TCP
---
apiVersion: v1
kind: Endpoints
metadata:
  name: {{ svc_name }}-ext
  namespace: {{ ns }}
subsets:
  - addresses:
      - ip: {{ svc.ip }}
    ports:
      - port: {{ svc.port }}
        protocol: TCP
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ svc.name }}-public
  namespace: {{ ns }}
  annotations:
    nginx.ingress.kubernetes.io/proxy-body-size: "50m"
{% if svc.disable_buffering | default(false) %}
    nginx.ingress.kubernetes.io/proxy-request-buffering: "off"
    nginx.ingress.kubernetes.io/proxy-buffering: "off"
{% endif %}
{% if svc.streaming | default(false) %}
    nginx.ingress.kubernetes.io/proxy-read-timeout: "3600"
    nginx.ingress.kubernetes.io/proxy-send-timeout: "3600"
    nginx.ingress.kubernetes.io/proxy-connect-timeout: "600"
{% endif %}
spec:
  ingressClassName: nginx
  tls:
    - hosts:
        - {{ svc.name }}.darkestserver.com
      secretName: cloudflare-origin-tls
  rules:
    - host: {{ svc.name }}.darkestserver.com
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: {{ svc_name }}-ext
                port:
                  number: {{ svc.port }}
{% endfor %}
