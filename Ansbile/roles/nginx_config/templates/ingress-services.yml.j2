        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
      }
{% endif %}
spec:
  ingressClassName: nginx
  tls:
    - hosts:
        - {{ svc.name }}.darkestserver.com
      secretName: cloudflare-origin-tls
  rules:
    - host: {{ svc.name }}.darkestserver.com
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: {{ svc_name }}-ext
                port:
                  number: {{ svc.port }}
{% endfor %}
