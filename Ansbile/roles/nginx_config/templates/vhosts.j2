server {
    listen 81 default_server;
    listen [::]:81 default_server;
    listen 8080;

    root /var/www/html;
    index index.html index.htm index.nginx-debian.html;

    server_name _;

    location / {
        try_files $uri $uri/ =404;
        root /usr/share/nginx/html;  # Define the root for the server
        index index.html index.htm;   # Default index files
    }
    location /status {
        stub_status on;   # Enable stub status
        allow all;        # Deny access from all other IPs
    }
}



# HTTP → HTTPS redirect
{% for svc in nginx_services %}
server {
    listen 80;
    server_name {{ svc.name }}.darkestserver.com;
    return 301 https://$host$request_uri;
}
{% endfor %}


# HTTPS services (Cloudflare origin cert)
{% for svc in nginx_services %}
server {
    listen 443 ssl http2;
    server_name {{ svc.name }}.darkestserver.com;

    ssl_certificate     /etc/nginx/certs/origin.pem;
    ssl_certificate_key /etc/nginx/certs/origin.key;

    ssl_protocols TLSv1.2 TLSv1.3;

    access_log off;

    {% if svc.streaming | default(false) %}
    gzip off;
    {% endif %}

    location / {
        proxy_pass http://{{ svc.ip }}:{{ svc.port }};
        include snippets/proxy-common.conf;

        {% if svc.disable_buffering | default(false) %}
        proxy_request_buffering off;
        {% endif %}
    }
}
{% endfor %}
